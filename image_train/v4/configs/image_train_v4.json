{
  "epochs": 12,
  "lr": 0.002,
  "min_lr": 0.00001,
  "weight_decay": 0.0001,
  "label_smoothing": 0.03,
  "grad_clip": 5.0,
  "scheduler": "cosine",
  "plateau_factor": 0.5,
  "plateau_patience": 2,
  "early_stopping": true,
  "patience": 4,
  "min_delta": 0.0001,
  "early_metric": "val_accuracy",
  "use_class_weights": true,
  "train_mode": "full_sequence",
  "window": 128,
  "stride": 32,
  "padding": 0.15,
  "rgb_smooth_window": 5,
  "proxy_smooth_window": 5,
  "hand_expand": 1.6,
  "postprocess_objective": "accuracy",
  "post_prob_smooth": "1,3,5,7",
  "post_min_segment": "1,3,5,8",
  "post_merge_gap": "0,2,4,8",
  "post_confidence_threshold": "0.0,0.25,0.4"
}
